    "RESULT",
    "worker_outcome",
    "completion_receipt",
    "handoff",
    "review_decision",
    "task_runtime_meta",
    "bounded_logs",
    "bounded_temporary_state"
  ],
  "task_main_authority": [
    "dispatch",
    "spec_creation",
    "spec_freeze",
    "task_approval",
    "task_start",
    "durable_decision",
    "work_item_closure",
    "workspace_selection"
  ],
  "project_steward_authority": [
    "docs_update",
    "artifact_link",
    "registry_refresh",
    "close_checks",
    "context_prepare",
    "relationship_resolve"
  ],
  "initialization_states": ["initialized_core", "initialized", "failed"],
  "initialization_receipt_minimum_fields": [
    "schema_version",
    "project_id",
    "workspace_id",
    "state",
    "git_summary",
    "codegraph_summary",
    "authority",
    "completed_at"
  ],
  "receipt_authorities": ["trusted_finalizer", "authoritative_receipt"],
