{
  "schema_version": 1,
  "fixture_name": "project-lifecycle-contract-minimum",
  "description": "Fixture for PCF-WI-PROJECT-LIFECYCLE-CONTRACT-MINIMUM verification Cases A-H",
  "dispatch_invariant": "PROJECT_AND_PROFILE_MUTATION_REQUIRES_TASK_MAIN_DISPATCH",
  "dispatch_authority_profiles": ["task-main"],
  "execution_owner_profiles": ["project-steward"],
  "protected_mutation_classes": [
    "project_initialization",
    "project_git_lifecycle",
    "project_codegraph_lifecycle",
    "project_registry_mutation",
    "project_closure",
    "project_metadata_mutation"
  ],
  "runtime_artifact_write_exemptions": [
